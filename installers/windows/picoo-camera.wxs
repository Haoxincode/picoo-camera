<?xml version="1.0" encoding="UTF-8"?>
<!-- Picoo Camera Windows installer — REQ-PICOO-VCAM-004 (WiX v4 scaffold) -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Picoo Camera"
      Manufacturer="Picoo"
      Version="0.1.0"
      UpgradeCode="A7C4E2F1-8B3D-4C6A-9E5F-1D2C3B4A5E70"
      Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Picoo Camera is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="Picoo Camera" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!-- CustomAction: regsvr32 PicooVirtualCameraSource.dll after install -->
    <CustomAction
        Id="RegisterVcamDll"
        Directory="INSTALLFOLDER"
        ExeCommand="regsvr32 /s &quot;[INSTALLFOLDER]PicooVirtualCameraSource.dll&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <CustomAction
        Id="UnregisterVcamDll"
        Directory="INSTALLFOLDER"
        ExeCommand="regsvr32 /u /s &quot;[INSTALLFOLDER]PicooVirtualCameraSource.dll&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <!-- MFCreateVirtualCamera Session is started by picoo-desktop on first launch (REQ-PICOO-VCAM-002). -->

    <InstallExecuteSequence>
      <Custom Action="RegisterVcamDll" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="UnregisterVcamDll" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Picoo Camera" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Picoo Camera" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="DesktopExe" Guid="A7C4E2F1-8B3D-4C6A-9E5F-1D2C3B4A5E71">
        <File Id="PicooDesktop" Source="!(bindpath.Bundle)\picoo-desktop.exe" KeyPath="yes" />
        <Shortcut
            Id="StartMenuDesktop"
            Directory="ApplicationProgramsFolder"
            Name="Picoo Camera"
            Target="[#PicooDesktop]"
            WorkingDirectory="INSTALLFOLDER"
            Advertise="no" />
        <RemoveFolder Id="RemoveProgramMenu" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Picoo\PicooCamera"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="no" />
      </Component>
      <Component Id="VcamDll" Guid="A7C4E2F1-8B3D-4C6A-9E5F-1D2C3B4A5E72">
        <File Id="PicooVcamDll" Source="!(bindpath.Bundle)\PicooVirtualCameraSource.dll" KeyPath="yes" />
      </Component>
      <Component Id="RingReader" Guid="A7C4E2F1-8B3D-4C6A-9E5F-1D2C3B4A5E73">
        <File Id="PicooRingReader" Source="!(bindpath.Bundle)\picoo-vcam-ring-reader.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
