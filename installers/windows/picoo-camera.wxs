<?xml version="1.0" encoding="UTF-8"?>
<!-- Picoo Camera Windows installer — REQ-PICOO-VCAM-004 (WiX v4 scaffold) -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="Picoo Camera"
      Manufacturer="Picoo"
      Version="$(PicooMsiVersion)"
      UpgradeCode="A7C4E2F1-8B3D-4C6A-9E5F-1D2C3B4A5E70"
      Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Picoo Camera is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="PicooProductIcon" SourceFile="!(bindpath.Bundle)\PicooCamera.ico" />
    <Property Id="ARPPRODUCTICON" Value="PicooProductIcon" />

    <Feature Id="ProductFeature" Title="Picoo Camera" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!-- COM registration is declarative WiX data. The Rust cdylib intentionally does not
         self-register; MF virtual-camera registration runs after files and registry values
         are installed. -->

    <SetProperty
        Id="RegisterVcamOnInstall"
        Value="&quot;[#PicooDesktop]&quot; --register-vcam --no-wait"
        Before="RegisterVcamOnInstall"
        Sequence="execute" />
    <CustomAction
        Id="RegisterVcamOnInstall"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="yes"
        Return="ignore" />

    <SetProperty
        Id="UnregisterVcamOnRemove"
        Value="&quot;[#PicooDesktop]&quot; --unregister-vcam"
        Before="UnregisterVcamOnRemove"
        Sequence="execute" />
    <CustomAction
        Id="UnregisterVcamOnRemove"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="yes"
        Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RegisterVcamOnInstall" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="UnregisterVcamOnRemove" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Picoo Camera" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Picoo Camera" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="DesktopExe" Guid="A7C4E2F1-8B3D-4C6A-9E5F-1D2C3B4A5E71">
        <File Id="PicooDesktop" Source="!(bindpath.Bundle)\picoo-desktop.exe" KeyPath="yes" />
        <Shortcut
            Id="StartMenuDesktop"
            Directory="ApplicationProgramsFolder"
            Name="Picoo Camera"
            Target="[#PicooDesktop]"
            WorkingDirectory="INSTALLFOLDER"
            Advertise="no" />
        <RemoveFolder Id="RemoveProgramMenu" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Picoo\PicooCamera"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="no" />
      </Component>
      <Component Id="VcamDll" Guid="A7C4E2F1-8B3D-4C6A-9E5F-1D2C3B4A5E72">
        <File Id="PicooVcamDll" Source="!(bindpath.Bundle)\PicooVirtualCameraSource.dll" KeyPath="yes" />
        <!-- CLSID must match the Rust VCam Source and vcam_register.rs (REQ-PICOO-VCAM-002/004). -->
        <RegistryValue
            Root="HKLM"
            Key="Software\Classes\CLSID\{A7C4E2F1-8B3D-4C6A-9E5F-1D2C3B4A5E6F}"
            Type="string"
            Value="Picoo Camera"
            KeyPath="no" />
        <RegistryValue
            Root="HKLM"
            Key="Software\Classes\CLSID\{A7C4E2F1-8B3D-4C6A-9E5F-1D2C3B4A5E6F}\InprocServer32"
            Type="string"
            Value="[#PicooVcamDll]"
            KeyPath="no" />
        <RegistryValue
            Root="HKLM"
            Key="Software\Classes\CLSID\{A7C4E2F1-8B3D-4C6A-9E5F-1D2C3B4A5E6F}\InprocServer32"
            Name="ThreadingModel"
            Type="string"
            Value="Both"
            KeyPath="no" />
      </Component>
      <Component Id="RingReader" Guid="A7C4E2F1-8B3D-4C6A-9E5F-1D2C3B4A5E73">
        <File Id="PicooRingReader" Source="!(bindpath.Bundle)\picoo-vcam-ring-reader.exe" KeyPath="yes" />
      </Component>
      <!-- REQ-PICOO-VCAM-004 / DISCOVERY-001: allow QUIC and DNS-SD discovery. -->
      <Component Id="FirewallQuic" Guid="A7C4E2F1-8B3D-4C6A-9E5F-1D2C3B4A5E74">
        <RegistryValue
            Root="HKLM"
            Key="Software\Picoo\PicooCamera"
            Name="firewall_quic"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        <fw:FirewallException
            Id="PicooQuicUdp"
            Name="Picoo Camera QUIC"
            Protocol="udp"
            Port="4433"
            Scope="any"
            IgnoreFailure="yes" />
        <fw:FirewallException
            Id="PicooMdnsUdp"
            Name="Picoo Camera Discovery"
            Protocol="udp"
            Port="5353"
            Scope="any"
            IgnoreFailure="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
